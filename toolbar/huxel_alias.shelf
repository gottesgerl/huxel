\set noalias = 1
set saved_path = `execute("oppwf")`
opcf $arg1

# Node $_obj_mosaic_add1 (Sop/add)
set _obj_mosaic_add1 = `run("opadd -e -n -v add add1")`
oplocate -x `$arg2 + 0` -y `$arg3 + 0` $_obj_mosaic_add1
opparm $_obj_mosaic_add1  points ( 0 ) prims ( 1 )
opparm -V 21.0.700 $_obj_mosaic_add1 keep ( on )
opset -d off -r off -h off -f off -y off -t off -l off -s off -u off -F on -c on -e on -b off $_obj_mosaic_add1
opexprlanguage -s hscript $_obj_mosaic_add1
opset -p on $_obj_mosaic_add1

opcf $arg1
opwire -n $_obj_mosaic_box1 -0 $_obj_mosaic_add1

set oidx = 0
if ($argc >= 9 && "$arg9" != "") then
    set oidx = $arg9
endif

if ($argc >= 5 && "$arg4" != "") then

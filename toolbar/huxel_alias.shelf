   set arg2 = 0
endif
if ($argc < 3 || "$arg3" == "") then
   set arg3 = 0
endif
# Automatically generated script
# $arg1 - the path to add this node
# $arg2 - x position of the tile
# $arg3 - y position of the tile
# $arg4 - input node to wire to
# $arg5 - which input to wire to
# $arg6 - output node to wire to
# $arg7 - the type of this node
# $arg8 - the node is an indirect input
# $arg9 - index of output from $arg6

\set noalias = 1
set saved_path = `execute("oppwf")`
opcf $arg1

# Node $_obj_mosaic_polypath8 (Sop/polypath)
set _obj_mosaic_polypath8 = `run("opadd -e -n -v polypath polypath8")`
oplocate -x `$arg2 + 0` -y `$arg3 + 0` $_obj_mosaic_polypath8
opset -d off -r off -h off -f off -y off -t off -l off -s off -u off -F on -c on -e on -b off $_obj_mosaic_polypath8
opexprlanguage -s hscript $_obj_mosaic_polypath8
opuserdata -n '___Version___' -v '' $_obj_mosaic_polypath8
opset -p on $_obj_mosaic_polypath8

opcf $arg1
opwire -n $_obj_mosaic_fuse5 -0 $_obj_mosaic_polypath8

set oidx = 0
if ($argc >= 9 && "$arg9" != "") then
    set oidx = $arg9
endif

if ($argc >= 5 && "$arg4" != "") then
    set output = $_obj_mosaic_polypath8
    opwire -n $output -$arg5 $arg4
endif
if ($argc >= 6 && "$arg6" != "") then
    set input = $_obj_mosaic_polypath8
    if ($arg8) then
        opwire -n -i $arg6 -0 $input
    else
        opwire -n -o $oidx $arg6 -0 $input
    endif
endif
opcf $saved_path
'''
hou.hscript(h_preamble + h_extra_args + h_cmd)
]]></script>
  </tool>
</shelfDocument>

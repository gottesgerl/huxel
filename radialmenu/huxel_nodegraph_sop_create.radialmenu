{
	"fileversion":"21.0.700",
	"name":"huxel_nodegraph_sop_create",
	"categories":"Standard",
	"pane":"network",
	"label":"Huxel - Nodegraph - SOP _create_",
	"type":"submenu",
	"items":{
		"0":{
			"label":"Transform",
			"type":"script_action",
			"icon":"SOP_xform",
			"script":"#store current selection\ncontext_type = \"sop\" \nnode_type = \"xform\"\nsel = hou.selectedNodes()\nsource = sel[0] if sel else None\n\n# with a node selected: Place and connect\nif source is not None:\n    p = source.parent()\n    outputs = source.outputsAsData()\n    curNode = p.createNode(node_type)\n    curNode.setInput(0, source)\n    curNode.setOutputsFromData(outputs)\n    curNode.setPosition(source.position() + hou.Vector2(0, -1))\n    curNode.moveToGoodPosition(relative_to_inputs=True, move_inputs=False, move_outputs=True,move_unconnected=True)\n    if (source.isDisplayFlagSet() == True):   curNode.setDisplayFlag(True)\n    if (source.isRenderFlagSet() == True):    curNode.setRenderFlag(True)\n    curNode.setCurrent(True, clear_all_selected=True)\n\n# without selection\nelse: \n    #curNode = radialmenu.runShelfTool(kwargs, (context_type+\"_\"+node_type))\n    curNode = soptoolutils.genericTool(kwargs, (node_type))\n    connections = curNode.inputs()\n    if connections:\n        if (connections[0].isDisplayFlagSet() == True):   curNode.setDisplayFlag(True)\n        if (connections[0].isRenderFlagSet() == True):    curNode.setRenderFlag(True)"
		},
		"1":{
			"label":"Box",
			"type":"script_action",
			"icon":"SOP_box",
			"script":"radialmenu.runShelfTool(kwargs, 'sop_box')"
		},
		"2":{
			"label":"Group",
			"type":"script_action",
			"icon":"SOP_groupcreate",
			"script":"#####################\n#\n#   GROUP\n#   by Hannes Gerl, 2025.mar.26\n#       v0.1\n#\n#   creates a group node\n#   names it \"grp_\" + a popup dialog will appear for the groups name\n#\n#   hotkey: None\n#   icon: SOP_groupcreate\n#       context: SOP\n#\n\nprefix = \"grp_\"\n\n\nimport soptoolutils\n\n#store current selection\ncontext_type = \"sop\" \nnode_type = \"groupcreate\"\nsel = hou.selectedNodes()\nsource = sel[0] if sel else None\ncurNode = \"\"\n\n# with a node selected: Place and connect\nif source is not None:\n    p = source.parent()\n    outputs = source.outputsAsData()\n    curNode = p.createNode(node_type)\n    curNode.setInput(0, source)\n    curNode.setOutputsFromData(outputs)\n    curNode.setPosition(source.position() + hou.Vector2(0, -1))\n    curNode.moveToGoodPosition(relative_to_inputs=True, move_inputs=False, move_outputs=True,move_unconnected=True)\n    if (source.isDisplayFlagSet() == True):   curNode.setDisplayFlag(True)\n    if (source.isRenderFlagSet() == True):    curNode.setRenderFlag(True)\n    curNode.setCurrent(True, clear_all_selected=True)\n   \n# without selection\nelse: \n    #curNode = radialmenu.runShelfTool(kwargs, (context_type+\"_\"+node_type))\n    curNode = soptoolutils.genericTool(kwargs, (node_type))\n    connections = curNode.inputs()\n    if connections:\n        if (connections[0].isDisplayFlagSet() == True):   curNode.setDisplayFlag(True)\n        if (connections[0].isRenderFlagSet() == True):    curNode.setRenderFlag(True)\n        \ncurNode.parm(\"groupname\").set('`strreplace(strreplace($OS, \"'+prefix+'\", \"\"), opdigits(strreplace($OS, \"'+prefix+'_\", \"\")), \"\")`')\ncurNode.setDisplayDescriptiveNameFlag(False)\n\nuserName = prefix+hou.ui.readInput('Enter Group Name', title='Create Group', initial_contents=\"\")[1]\ncurNode.setName(userName, unique_name=True)"
		},
		"3":{
			"label":"OUT",
			"type":"script_action",
			"icon":"OBJ_null",
			"script":"#####################\n#import mouseevents\n#import nodegraphview as view\n\nname = \"OUT\"\n\ncontext_type = \"sop\" \nnode_type = \"null\"\n\nimport soptoolutils\n\neditor = kwargs['pane']\n\n#store current selection\nsel = hou.selectedNodes()\nsource = sel[0] if sel else None\n\n# with a node selected: Place and connect\nif source is not None:\n    p = source.parent()\n    outputs = source.outputsAsData()\n    curNode = p.createNode(node_type)\n    curNode.setInput(0, source)\n    curNode.setOutputsFromData(outputs)\n    curNode.setPosition(source.position() + hou.Vector2(0, -1))\n    curNode.moveToGoodPosition(relative_to_inputs=True, move_inputs=False, move_outputs=True,move_unconnected=True)\n    if (source.isRenderFlagSet() == True):    curNode.setRenderFlag(True)\n    curNode.setCurrent(True, clear_all_selected=True)\n\n# without selection\nelse:\n    curNode = soptoolutils.genericTool(kwargs, 'node_type')\n    connections = curNode.inputs()\n    if connections:\n        if (connections[0].isDisplayFlagSet() == True):   curNode.setDisplayFlag(True)\n        if (connections[0].isRenderFlagSet() == True):    curNode.setRenderFlag(True)    \n    \n# naming\n\ntry:\n    curNode.setName(name)\n    \nexcept:\n    try:\n        userName = hou.ui.readInput('OUT already exists. Enter suffix', title='create OUT Null', initial_contents=\"OUT_\")[1]\n        curNode.setName(userName)\n    except:\n        userName = hou.ui.readInput('OUT suffix exists. Enter another suffix', title='create OUT Null', initial_contents=\"OUT_\")[1]\n        curNode.setName(userName)\n"
		},
		"4":{
			"label":"Obj Merge From Clipboard",
			"type":"script_action",
			"icon":"BUTTONS_down",
			"script":"#####################\n#\n#   CLIPBOARD TO OBJECT MERGE\n#   by Hannes Gerl, 2024.sep.20\n#   with help from https://berniebernie.fr/wiki/Houdini_Python\n#   Thank you!\n#   v0.1\n#\n#   Creates Object Merge Nodes based on the current clipboard\n#\n#   hotkey: None\n#       icon: PLASMA_App (None)\n#       context: Ctrl+Shift+B\n#\n\n\nnetwork = hou.ui.curDesktop().paneTabUnderCursor()\nparent = network.pwd().path()\nmouse_pos = network.cursorPosition()\nclipboard = hou.ui.getTextFromClipboard()\n\nprefix = \"IN_\"\noffset = 0.0\noffset_min = 1\noffset_per_letter = .1\nnodes = []\n\nif clipboard:\n    list = clipboard.split()\n    for item in list:\n        node = hou.node(item)\n        if node != None:\n            nicename = prefix+node.name().replace(\"OUT_\", \"\")\n            obj_merge = hou.node(parent).createNode('object_merge')\n            obj_merge.setName(nicename, 1)\n            obj_merge.parm('objpath1').set(node.path())\n            obj_merge.setPosition(mouse_pos)\n            obj_merge.move([len(nodes)*offset_min,0])\n            obj_merge.move([offset,0])\n            offset += obj_merge.size()[0]+(len(obj_merge.name())*offset_per_letter)\n            if not len(nodes): obj_merge.setSelected(True, True)\n            else:              obj_merge.setSelected(True, False)\n            obj_merge.setDisplayDescriptiveNameFlag(False)\n            nodes.append(obj_merge)\n            \nif not len(nodes): hou.ui.setStatusMessage(\"No nodes found in clipboard. Please copy (ctrl+c) a node/nodes to the clipboard first.\", hou.severityType.ImportantMessage)"
		},
		"5":{
			"label":"Blast",
			"type":"script_action",
			"icon":"SOP_blast",
			"script":"#####################\n#\n#   GROUP\n#   by Hannes Gerl, 2025.mar.26\n#       v0.1\n#\n#   creates a group node\n#   names it \"grp_\" + a popup dialog will appear for the groups name\n#\n#   hotkey: None\n#   icon: SOP_groupcreate\n#       context: SOP\n#\n\nprefix = \"blast_\"\n\n\nimport soptoolutils\n\n#store current selection\ncontext_type = \"sop\" \nnode_type = \"blast\"\nsel = hou.selectedNodes()\nsource = sel[0] if sel else None\ncurNode = \"\"\n\n# with a node selected: Place and connect\nif source is not None:\n    p = source.parent()\n    outputs = source.outputsAsData()\n    curNode = p.createNode(node_type)\n    curNode.setInput(0, source)\n    curNode.setOutputsFromData(outputs)\n    curNode.setPosition(source.position() + hou.Vector2(0, -1))\n    curNode.moveToGoodPosition(relative_to_inputs=True, move_inputs=False, move_outputs=True,move_unconnected=True)\n    if (source.isRenderFlagSet() == True):    curNode.setRenderFlag(True)\n    curNode.setCurrent(True, clear_all_selected=True)\n   \n# without selection\nelse: \n    #curNode = radialmenu.runShelfTool(kwargs, (context_type+\"_\"+node_type))\n    curNode = soptoolutils.genericTool(kwargs, (node_type))\n    connections = curNode.inputs()\n    if connections:\n        if (connections[0].isDisplayFlagSet() == True):   curNode.setDisplayFlag(True)\n        if (connections[0].isRenderFlagSet() == True):    curNode.setRenderFlag(True)\n        \ncurNode.parm(\"group\").set('`strreplace(strreplace($OS, \"'+prefix+'\", \"\"), opdigits(strreplace($OS, \"'+prefix+'_\", \"\")), \"\")`')\ncurNode.setDisplayDescriptiveNameFlag(False)\n\nuserName = prefix+hou.ui.readInput('Enter Blast Name', title='Blast', initial_contents=\"\")[1]\ncurNode.setName(userName, unique_name=True)"
		},
		"6":{
			"label":"Wrangle",
			"type":"script_action",
			"icon":"SOP_attribwrangle",
			"script":"#store current selection\ncontext_type = \"sop\" \nnode_type = \"attribwrangle\"\nsel = hou.selectedNodes()\nsource = sel[0] if sel else None\n\n# with a node selected: Place and connect\nif source is not None:\n    p = source.parent()\n    outputs = source.outputsAsData()\n    curNode = p.createNode(node_type)\n    curNode.setInput(0, source)\n    curNode.setOutputsFromData(outputs)\n    curNode.setPosition(source.position() + hou.Vector2(0, -1))\n    curNode.moveToGoodPosition(relative_to_inputs=True, move_inputs=False, move_outputs=True,move_unconnected=True)\n    if (source.isDisplayFlagSet() == True):   curNode.setDisplayFlag(True)\n    if (source.isRenderFlagSet() == True):    curNode.setRenderFlag(True)\n    curNode.setCurrent(True, clear_all_selected=True)\n\n# without selection\nelse: \n    #curNode = radialmenu.runShelfTool(kwargs, (context_type+\"_\"+node_type))\n    curNode = soptoolutils.genericTool(kwargs, (node_type))\n    connections = curNode.inputs()\n    if connections:\n        if (connections[0].isDisplayFlagSet() == True):   curNode.setDisplayFlag(True)\n        if (connections[0].isRenderFlagSet() == True):    curNode.setRenderFlag(True)"
		},
		"7":{

{
	"fileversion":"21.0.440",
	"name":"hg_radial_network_view",
	"categories":"Standard",
	"pane":"network",
	"label":"HANNES Network View",
	"type":"submenu",
	"items":{
		"0":{
			"label":"NOTE",
			"type":"script_action",
			"icon":"BUTTONS_match_case",
			"script":"sel = hou.selectedItems()\ndesktop = hou.ui.curDesktop()\npane = hou.ui.paneUnderCursor()\npp = pane.currentTab()\ncp = pp.cursorPosition(confine_to_view=False)\nwidth = 3\nheight = 1.5\ntextSize = 0.85\n\np = pp.pwd()    \nnew_box = p.createStickyNote()\nnew_box.setColor(hou.Color(0.576, 0.208, 0.457))\nnew_box.setDrawBackground(0)\nnew_box.setTextColor(hou.Color(1, 0.75, 0))\nnew_box.setTextSize(textSize)\nnew_box.setText(\"Lorem\")\nnew_box.setPosition(hou.Vector2(cp[0],cp[1]))\nnew_box.setSize(hou.Vector2(width,height))\n\n    "
		},
		"1":{
			"label":"Kill Last Letter",
			"type":"script_action",
			"icon":"BUTTONS_jump_to_startframe",
			"script":"#####################\n#\n#   KILL LAST LETTER\n#   by Hannes Gerl, 2025.jul.16\n#   v0.1\n#\n#   kills the last letter of all selected node names\n#\n#   hotkey: None\n#   icon: BUTTONS_jump_to_startframe\n#   context: None\n#\nimport hou\n\ndef kill_last_letter(verbose=0):   \n    sel = hou.selectedNodes()    \n    \n    for s in sel:\n        name = s.name()\n        newname = name[:-1]\n        s.setName(newname)\n       \n    if verbose: \n        print(f\" RENAMED: {name} ---> {newname}\")\n        hou.ui.setStatusMessage(f\"Renamed {len(sel)} files\", severity=hou.severityType.Message)\n    \n\nkill_last_letter()\n"
		},
		"2":{
			"label":"Sel LOCAL",
			"type":"script_action",
			"icon":"SOP_each",
			"script":"#####################\n#\n#       SELECT ALL LOCAL\n#   by Hannes Gerl, 2022.mar.03\n#       v0.1\n#\n#   returns all nodes of the same type (instances)\n#   in the local sop context#   \n#\n#   hotkey: None\n#       icon: SOP_each\n#       context: None\n#\n\nimport hou\n\nlocal=1\nverbose=0\n\n\nsel = hou.selectedNodes()\nall_instances = []\n\n\nfor s in sel:\n    cur_type = s.type()    \n    cur_instances = cur_type.instances()\n    #print(\"S:%s  cur_type:%s   instances:%s\\n\" %(s,cur_type,cur_instances))\n    for i in cur_instances:\n        if local: \n            if i in s.parent().children():\n                i.setSelected(1)\n                if verbose>1: print(\"%s\" %i)\n        else: \n            i.setSelected(1)\n            if verbose>1: print(\"%s\" %i.path())\n    #all_instances.expand(cur_instances)\n\n    \nif verbose: print(\"%s nodes selected.\" %len(hou.selectedNodes()))\n    \n    \n\n\n"
		},
		"3":{
			"label":"MANUAL",
			"type":"script_action",
			"icon":"SOP_polyreduce-2.0",
			"script":"#####################\n#\n#      MANUAL EDITS MODE\n#       by Hannes Gerl, 2023.mar.23\n#       v0.1\n#\n#   Script that toogles node shapes and colors \n#   to (de)mark of manual changes\n#\n#   hotkey: None\n#       icon: PLASMA_App (None)\n#       context: None\n#\n\n\n\nimport hou\n\nvis_color = hou.Color(1, 0, 0)\nvis_shape = \"null\"\n\nverbose=0\n\n\nsel = hou.selectedNodes()\ncounter_vis = 0\ncounter_devis = 0\n\nfor s in sel:\n    #geting the current state\n    cur_color = s.color()\n    cur_shape = s.userData(\"nodeshape\")\n\n\n    #setting back to default color and shape\n    if (cur_color == vis_color) and (cur_shape == vis_shape):\n        counter_devis += 1\n        default_color = s.type().defaultColor()\n        default_shape = s.type().defaultShape()\n        s.setColor(default_color)\n        s.setUserData(\"nodeshape\", default_shape)\n        \n    #setting to vis_color and vis_shape \n    else:\n        counter_vis += 1\n        s.setColor(vis_color)\n        s.setUserData(\"nodeshape\", vis_shape)\n\n\nif verbose: print(\"%s nodes switched to manual edits mode.\\t%s nodes switched back\" %(counter_vis, counter_devis))    \n\n\n\n"
		},
		"4":{
			"label":"NETWORK Box",
			"type":"script_action",
			"icon":"SOP_polysoup",
			"script":"sel = hou.selectedItems()\ndesktop = hou.ui.curDesktop()\npane = hou.ui.paneUnderCursor()\npp = pane.currentTab()\ncp = pp.cursorPosition(confine_to_view=False)\nnew_boxes = []\npos_x = 0\n\nwidth = 5\nheight = 10\ngap = .33\n\nif not sel:\n    p = pp.pwd()    \n    new_box = p.createNetworkBox()\n    new_box.setColor(s.color())\n    new_box.setPosition(hou.Vector2(cp[0],cp[1]-height))\n    new_box.setSize(hou.Vector2(width,height))\n    hou.setSelected(1)\nelse: \n    for s in sel: \n        p = s.parent()\n        new_box = p.createNetworkBox()\n        new_box.setColor(s.color())\n        new_box.setPosition(s.position())\n        new_box.move(hou.Vector2(s.size()[0]+gap,0))\n        new_box.setSize(s.size())\n        new_boxes.append(new_box)\n        new_box.setSelected(1)\n        s.setSelected(0)\n"
		},
		"5":{
			"label":"Batches",
			"type":"script_action",
			"icon":"BUTTONS_comment_out",
			"script":"#####################\n#\n#      TOOGLE BATCH\n#   by Hannes Gerl, 2022.oct.27\n#       v0.1\n#\n#   Script that toogles node batches visibility on/off\n#\n#   hotkey: None\n#       icon: PLASMA_App (None)\n#       context: None\n#\n\n\n\nimport hou\n\n\nverbose=0\nsel = hou.selectedNodes()\n\n\nfor s in sel:\n    #geting the current state\n    cur_state = s.isDisplayDescriptiveNameFlagSet()\n    new_state = abs(cur_state-1)\n    \n    s.setDisplayDescriptiveNameFlag(new_state)\n    \n    message = [\"off\", \"on\"]\n\n    if verbose: print(\"%s badges turned %s.\" %(s, message[new_state]))   \n\n\n\n"
		},
		"6":{
			"label":"Sel by NAME",
			"type":"script_action",
			"icon":"SOP_each",
			"script":"#####################\n#\n#       SELECT BY NAME\n#   by Hannes Gerl, 2026.may.28\n#       v0.5\n#\n#   small Qt parameter dialog (PySide6 / PySide2):\n#       - node types: info field (selected types to run over)\n#       - scope:      dropdown (global / local)\n#       - match name: toggle button\n#       - name:       text field\n#       - verbosity:  dropdown (0 / 1 / 2)\n#\n#   hotkey: None\n#       icon: SOP_each\n#       context: None\n#\nimport hou\n\n# --- Qt binding: PySide6 (H21+) or PySide2 (H20 and earlier) -------------\ntry:\n    from PySide6 import QtWidgets, QtCore\n    _exec = lambda d: d.exec()          # PySide6\nexcept ImportError:\n    from PySide2 import QtWidgets, QtCore\n    _exec = lambda d: d.exec_()         # PySide2\n\n# --- Defaults -----------------------------------------------------------\nDEF_SCOPE   = \"global\"   # or \"local\"\nDEF_MATCH   = True\nDEF_NAME    = \"ao\"\nDEF_VERBOSE = 2\n\nsel = hou.selectedNodes()\n\n# --- Collect distinct selected node types (preserve order) --------------\nsel_types = []\nfor s in sel:\n    if s.type() not in sel_types:\n        sel_types.append(s.type())\ntypes_label = \", \".join(t.name() for t in sel_types) if sel_types else \"(none)\"\n\n\nclass ParamDialog(QtWidgets.QDialog):\n    def __init__(self, parent=hou.qt.mainWindow()):\n        super(ParamDialog, self).__init__(parent)\n        self.setWindowTitle(\"Select Nodes\")\n        self.setMinimumWidth(320)\n        self.result = None\n\n        form = QtWidgets.QFormLayout()\n\n        # 0) info: node types the script will run over (read-only)\n        self.types = QtWidgets.QLineEdit(types_label)\n        self.types.setReadOnly(True)\n        self.types.setStyleSheet(\"color: #aaaaaa;\")\n        self.types.setToolTip(\"Selected node types the script will run over\")\n        form.addRow(\"Node types\", self.types)\n\n        # 1) scope dropdown\n        self.scope = QtWidgets.QComboBox()\n        self.scope.addItems([\"global\", \"local\"])\n        self.scope.setCurrentText(DEF_SCOPE)\n        form.addRow(\"Scope\", self.scope)\n\n        # 2) match-name toggle button\n        self.match = QtWidgets.QPushButton()\n        self.match.setCheckable(True)\n        self.match.setChecked(DEF_MATCH)\n        self._refresh_match_label()\n        self.match.toggled.connect(self._refresh_match_label)\n        form.addRow(\"Match name\", self.match)\n\n        # 3) name text field\n        self.name = QtWidgets.QLineEdit(DEF_NAME)\n        form.addRow(\"Name filter\", self.name)\n\n        # 4) verbosity dropdown\n        self.verbose = QtWidgets.QComboBox()\n        self.verbose.addItems([\"0\", \"1\", \"2\"])\n        self.verbose.setCurrentText(str(DEF_VERBOSE))\n        form.addRow(\"Verbosity\", self.verbose)\n\n        # OK / Cancel\n        buttons = QtWidgets.QDialogButtonBox(\n            QtWidgets.QDialogButtonBox.Ok | QtWidgets.QDialogButtonBox.Cancel\n        )\n        buttons.accepted.connect(self._accept)\n        buttons.rejected.connect(self.reject)\n\n        layout = QtWidgets.QVBoxLayout(self)\n        layout.addLayout(form)\n        layout.addWidget(buttons)\n\n    def _refresh_match_label(self):\n        self.match.setText(\"On\" if self.match.isChecked() else \"Off\")\n\n    def _accept(self):\n        self.result = {\n            \"local\":     1 if self.scope.currentText() == \"local\" else 0,\n            \"matchname\": 1 if self.match.isChecked() else 0,\n            \"name\":      self.name.text().strip(),\n            \"verbose\":   int(self.verbose.currentText()),\n        }\n        self.accept()\n\n\n# --- Show dialog --------------------------------------------------------\ndlg = ParamDialog()\nif _exec(dlg) == QtWidgets.QDialog.Accepted:\n    p = dlg.result\n    \n    local     = p[\"local\"]\n    matchname = p[\"matchname\"]\n    name      = p[\"name\"]\n    verbose   = p[\"verbose\"]\n    \n    if matchname and name == \"\":\n        matchname = 0   # empty filter -> match all\n    \n    # --- Core ---------------------------------------------------------------\n    def add_to_selection(i):\n        add = 0\n        if not matchname:\n            add = 1\n        if matchname and name in i.name():\n            add = 1\n        if add:\n            i.setSelected(1)\n            if verbose > 1:\n                print(\"%s\" % i.path())\n    \n    hou.clearAllSelected()\n    \n    for cur_type in sel_types:\n        for i in cur_type.instances():\n            if local:\n                if any(i in s.parent().children() for s in sel if s.type() == cur_type):\n                    add_to_selection(i)\n            else:\n                add_to_selection(i)\n    \n    if verbose:\n        print(\"Scope:%s  filter:'%s'  ->  %s nodes selected.\" % (\n            \"local\" if local else \"global\",\n            name if matchname else \"(all)\",\n            len(hou.selectedNodes()),\n        ))"
		},
		"7":{
			"label":"VIEW",
			"type":"script_action",
			"icon":"VIEW_visualization",
			"script":"#####################\n#\n#      VISUALIZER MODE\n#   by Hannes Gerl, 2022.mar.07\n#       v0.1\n#\n#   Script that toogles node shapes and colors \n#   to (de)mark of being present for visual purposes only\n#\n#   hotkey: None\n#       icon: PLASMA_App (None)\n#       context: None\n#\n\n\n\nimport hou\n\nvis_color = hou.Color(0.094, 0.369, 0.69)\nvis_shape = \"ciircle_1TinyA\"\n\nverbose=0\n\n\nsel = hou.selectedNodes()\ncounter_vis = 0\ncounter_devis = 0\n\nfor s in sel:\n    #geting the current state\n    cur_color = s.color()\n    cur_shape = s.userData(\"nodeshape\")\n\n\n    #setting back to default color and shape\n    if (cur_color == vis_color) and (cur_shape == vis_shape):\n        counter_devis += 1\n        default_color = s.type().defaultColor()\n        default_shape = s.type().defaultShape()\n        s.setColor(default_color)\n        s.setUserData(\"nodeshape\", default_shape)\n        \n    #setting to vis_color and vis_shape \n    else:\n        counter_vis += 1\n        s.setColor(vis_color)\n        s.setUserData(\"nodeshape\", vis_shape)\n\n\nif verbose: print(\"%s nodes switched to visualize mode.\\t%s nodes switched back\" %(counter_vis, counter_devis))    \n\n\n\n"
		}
	}
}

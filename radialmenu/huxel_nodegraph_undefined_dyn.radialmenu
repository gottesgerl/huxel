{
	"fileversion":"20.5.487",
	"name":"huxel_nodegraph_undefined_dyn",
	"categories":"Standard",
	"pane":"network",
	"label":"Huxel - Nodegraph __undefined_ (dyn)",
	"type":"script_submenu",
	"script":"import huxelradialmenus.commontools as commontools\n\nimportlib.reload(commontools)\n\n#-----------------------------------------\n#\n#   Handles All Nodegraph Radial Menus\n#\n#-----------------------------------------\n\n\n# Get closest node\nmax_distance = 2\ndebug = 1\n\nkwargs = commontools.getClosestNode()\n\n# Fill the cardinal directions (N, S, E, W) first, then the diagonals\nslots = (\"n\", \"ne\", \"e\", \"se\", \"sw\", \"w\", \"nw\")\n\nnode = hou.node(kwargs[\"path\"])\ntype = node.type()\npresets = hou.hscript(\"oppresetls %s\" %node.path())[0].split(\"\\n\")\n\n# function to load presets\ndef loadPresetFunc(preset):\n    def wrapper(**kwargs):\n        hou.hscript(\"oppresetload %s '%s'\" %(node.path(), preset))\n    return wrapper\n        \n# Build a menu from preset elements    \nmenu = {}\n\nhou_preRecipeVersion = int(\"\".join(map(str, hou.applicationVersion())))<205000\n#Houdini 20.0 and below\nif hou_preRecipeVersion:\n    for slot, preset in zip(slots, presets[:7]):\n        menu[slot] = {\n            \"type\": \"script_action\",\n            \"label\": preset,\n            \"script\": loadPresetFunc(preset),\n            }\n#Houdini 20.5 and above - we do the same - till we find a way to scan for existing recipes\n# e.g. with>>> x = hrecipes.storage.PresetStore.recipesForNode(hrecipes.storage.PresetStore(), node, \"nodePreset\")\nelse:\n    for slot, preset in zip(slots, presets[:7]):\n        menu[slot] = {\n            \"type\": \"script_action\",\n            \"label\": preset,\n            \"script\": loadPresetFunc(preset),\n            }    \n\n# function to NEXT\ndef nextFunc(type, name):\n    def wrapper(**kwargs):\n        null = node.parent().createNode(type)\n        null.setName(name, 1)\n        null.setNextInput(node)    \n        null.moveToGoodPosition()\n        null.setDisplayFlag(1)\n        null.setSelected(1)\n    return wrapper  \n    \n# Add static elements\n'''\nmenu[\"s\"]= {\n        \"type\": \"script_action\",\n        \"label\": \"NEXT: Attribwrangle\",\n        \"icon\": \"SOP_attribwrangle\",\n        \"script\": nextFunc('attribwrangle', 'aw_'),    }\n'''\nradialmenu.setRadialMenu(menu)\n\n"
}
